# ==========================================
# Moltbot Standard Config
# ==========================================

# Gateway Authentication
# Shared token for Gateway <-> UI <-> CLI communication
CLAWDBOT_GATEWAY_TOKEN=
CLAWDBOT_GATEWAY_PASSWORD=

# Gateway Configuration
CLAWDBOT_GATEWAY_PORT=18789
CLAWDBOT_BRIDGE_PORT=18790
CLAWDBOT_GATEWAY_BIND=lan

# Anthropic / Claude Keys (Optional, mostly handled by agents now)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=


# ==========================================
# Docker Enhancements (Voice & GPU Stack)
# ==========================================

# [Required] OpenAI Key for the Gateway Agent
# This is passed directly to the 'moltbot' container via docker-compose
OPENAI_API_KEY=sk-...

# [Required] AWS Credentials for Voice Backend (TTS)
# These are passed to the 'voice-backend' container for Polly TTS
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# [Optional] Voice Backend Configuration
# Defaults: LANGUAGE=pt, WHISPER_DEVICE=cuda
LANGUAGE=pt
